      "type": "input",
      "text": "uang=200000; buku=25000;\nbulpen=8000;\nflashdisk=75000; diskon=0.10; PPN=0.11",
      "x": 229,
      "y": 10,
      "w": 190,
      "h": 135
    },
    {
      "id": 4,
      "type": "process",
      "text": "harga_buku = 3 * buku",
      "x": 509,
      "y": 44,
      "w": 180,
      "h": 66
    },
    {
      "id": 5,
      "type": "process",
      "text": "harga_bulpen = 2 * bulpen",
      "x": 510,
      "y": 143,
      "w": 180,
      "h": 66
    },
    {
      "id": 6,
      "type": "process",
      "text": "harga_flashdisk = 1 * flashdisk",
      "x": 509,
      "y": 242,
      "w": 180,
      "h": 66
    },
    {
      "id": 7,
      "type": "process",
      "text": "total_belanja=harga_buku+harga_bulpen+harga_flashdisk",
      "x": 509,
      "y": 340,
      "w": 180,
      "h": 70
    },
    {
      "id": 8,
      "type": "process",
      "text": "diskon = 0.10 * total_belanja",
      "x": 510,
      "y": 442,
      "w": 180,
      "h": 66
    },
    {
      "id": 9,
      "type": "process",
      "text": "setelah_diskon = total_belanja-diskon",
      "x": 510,
      "y": 548,
      "w": 180,
      "h": 66
    },
    {
      "id": 10,
      "type": "process",
      "text": "pajak = total_belanja*0.11",
      "x": 510,
      "y": 658,
      "w": 180,
      "h": 66
    },
    {
      "id": 11,
      "type": "process",
      "text": "total_bayar= setelah_diskon + pajak",
      "x": 510,
      "y": 773,
      "w": 180,
      "h": 66
    },
    {
      "id": 12,
      "type": "process",
      "text": "kembalian = uang - total_bayar",
      "x": 510,
      "y": 877,
      "w": 180,
      "h": 66
    },
